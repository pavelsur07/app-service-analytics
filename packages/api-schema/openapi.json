{
    "openapi": "3.0.0",
    "info": {
        "title": "Conwix API",
        "version": "0.1.0-dev"
    },
    "paths": {
        "/api/extension/me": {
            "get": {
                "operationId": "get_identity_extension_me",
                "responses": {
                    "200": {
                        "description": "\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u0438 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u044f, \u043a \u043a\u043e\u0442\u043e\u0440\u044b\u043c \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d \u043f\u0440\u0435\u0434\u044a\u044f\u0432\u043b\u0435\u043d\u043d\u044b\u0439 \u0442\u043e\u043a\u0435\u043d",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ExtensionMeResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "ExtensionToken": []
                    }
                ]
            }
        },
        "/api/companies/{companyId}/extension-tokens": {
            "post": {
                "operationId": "post_identity_extension_token_issue",
                "parameters": [
                    {
                        "name": "companyId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[13-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "\u0422\u043e\u043a\u0435\u043d \u0432\u044b\u043f\u0443\u0449\u0435\u043d. \u041f\u043e\u043b\u0435 token \u043e\u0442\u0434\u0430\u0451\u0442\u0441\u044f \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u0440\u0430\u0437 \u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/IssueExtensionTokenResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "operationId": "post_identity_auth_login",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "\u0412\u0445\u043e\u0434 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d, \u0441\u0435\u0441\u0441\u0438\u044f \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0430",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "\u041d\u0435\u0432\u0435\u0440\u043d\u044b\u0439 email \u0438\u043b\u0438 \u043f\u0430\u0440\u043e\u043b\u044c \u2014 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u043e \u0434\u043b\u044f \u043e\u0431\u043e\u0438\u0445 \u0441\u043b\u0443\u0447\u0430\u0435\u0432 (ADR-007)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/me": {
            "get": {
                "operationId": "get_identity_auth_me",
                "responses": {
                    "200": {
                        "description": "\u0422\u0435\u043a\u0443\u0449\u0438\u0439 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u0438 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438, \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0435 \u0435\u043c\u0443 \u043f\u043e \u0447\u043b\u0435\u043d\u0441\u0442\u0432\u0443",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MeResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/companies/{companyId}/extension-tokens/{id}": {
            "delete": {
                "operationId": "delete_identity_extension_token_revoke",
                "parameters": [
                    {
                        "name": "companyId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[13-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
                        }
                    },
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[13-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "\u0422\u043e\u043a\u0435\u043d \u043e\u0442\u043e\u0437\u0432\u0430\u043d. \u041f\u043e\u0432\u0442\u043e\u0440\u043d\u044b\u0439 \u043e\u0442\u0437\u044b\u0432 \u0438\u0434\u0435\u043c\u043f\u043e\u0442\u0435\u043d\u0442\u0435\u043d."
                    },
                    "404": {
                        "description": "\u0422\u043e\u043a\u0435\u043d\u0430 \u0441 \u0442\u0430\u043a\u0438\u043c id \u0432 \u044d\u0442\u043e\u0439 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438 \u043d\u0435\u0442",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/companies/{companyId}/ingestion/ozon/sales-facts": {
            "get": {
                "operationId": "get_ingestion_ozon_sales_facts_list",
                "parameters": [
                    {
                        "name": "companyId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "\u0421\u043f\u0438\u0441\u043e\u043a \u043f\u0440\u043e\u0434\u0430\u0436 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438, keyset-\u043f\u0430\u0433\u0438\u043d\u0430\u0446\u0438\u044f",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SalesFactListResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "\u041d\u0435\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u044b\u0439 limit \u0438\u043b\u0438 cursor",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/admin/ping": {
            "get": {
                "operationId": "get_admin_ping",
                "responses": {
                    "200": {
                        "description": "\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AppInfoResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/seller/ping": {
            "get": {
                "operationId": "get_seller_ping",
                "responses": {
                    "200": {
                        "description": "\u0418\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AppInfoResponse"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "MeCompanyResponse": {
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "ExtensionMeResponse": {
                "required": [
                    "email",
                    "company"
                ],
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "company": {
                        "$ref": "#/components/schemas/MeCompanyResponse"
                    }
                },
                "type": "object"
            },
            "IssueExtensionTokenResponse": {
                "required": [
                    "id",
                    "token",
                    "tokenPrefix",
                    "expiresAt"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "token": {
                        "type": "string"
                    },
                    "tokenPrefix": {
                        "type": "string"
                    },
                    "expiresAt": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "LoginResponse": {
                "required": [
                    "email"
                ],
                "properties": {
                    "email": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "ValidationErrorResponse": {
                "required": [
                    "status",
                    "code",
                    "message"
                ],
                "properties": {
                    "status": {
                        "type": "integer"
                    },
                    "code": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "MeResponse": {
                "required": [
                    "email",
                    "companies"
                ],
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "companies": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/MeCompanyResponse"
                        }
                    }
                },
                "type": "object"
            },
            "SalesFactListItemResponse": {
                "required": [
                    "marketplaceAccountId",
                    "sourceRowId",
                    "businessDate",
                    "status",
                    "marketplaceSku",
                    "quantity",
                    "amountMinor",
                    "commissionAmountMinor",
                    "currency"
                ],
                "properties": {
                    "marketplaceAccountId": {
                        "type": "string"
                    },
                    "sourceRowId": {
                        "type": "string"
                    },
                    "businessDate": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string"
                    },
                    "marketplaceSku": {
                        "type": "string"
                    },
                    "quantity": {
                        "type": "integer"
                    },
                    "amountMinor": {
                        "type": "integer"
                    },
                    "commissionAmountMinor": {
                        "type": "integer"
                    },
                    "currency": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "SalesFactListResponse": {
                "required": [
                    "items"
                ],
                "properties": {
                    "items": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/SalesFactListItemResponse"
                        }
                    },
                    "nextCursor": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "AppInfoResponse": {
                "required": [
                    "app",
                    "version",
                    "respondedAt"
                ],
                "properties": {
                    "app": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    },
                    "respondedAt": {
                        "type": "string"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "ExtensionToken": {
                "type": "http",
                "scheme": "bearer"
            }
        }
    }
}
