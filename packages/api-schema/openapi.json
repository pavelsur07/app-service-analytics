        "/api/extension/companies/{companyId}/skus/{marketplaceSku}/sales": {
            "get": {
                "operationId": "get_ingestion_extension_sku_sales",
                "parameters": [
                    {
                        "name": "days",
                        "in": "query",
                        "description": "\u041e\u043a\u043d\u043e \u0432 \u0434\u043d\u044f\u0445 \u043f\u043e \u0431\u0438\u0437\u043d\u0435\u0441-\u0434\u0430\u0442\u0435 \u043f\u043b\u043e\u0449\u0430\u0434\u043a\u0438",
                        "required": false,
