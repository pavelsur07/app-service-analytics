                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ExtensionMeResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "\u0422\u043e\u043a\u0435\u043d \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442, \u0438\u0441\u0442\u0451\u043a, \u043e\u0442\u043e\u0437\u0432\u0430\u043d \u0438\u043b\u0438 \u0443\u0447\u0430\u0441\u0442\u043d\u0438\u043a \u0438\u0441\u043a\u043b\u044e\u0447\u0451\u043d \u0438\u0437 \u043a\u043e\u043c\u043f\u0430\u043d\u0438\u0438",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "ExtensionToken": []
                    }
                ]
            }
        },
