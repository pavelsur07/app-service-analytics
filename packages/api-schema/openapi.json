                            "type": "integer",
                            "default": 30,
                            "maximum": 365,
                            "minimum": 1
                        }
                    },
                    {
                        "name": "companyId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[13-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
                        }
                    },
                    {
                        "name": "marketplaceSku",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "[A-Za-z0-9_-]{1,64}"
                        }
                    }
                ],
