                    "200": {
                        "description": "\u0417\u0430\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u0435 \u0438 \u043e\u0442\u043c\u0435\u043d\u0451\u043d\u043d\u043e\u0435 \u043f\u043e \u0430\u0440\u0442\u0438\u043a\u0443\u043b\u0443 \u0437\u0430 \u043e\u043a\u043d\u043e \u0434\u043d\u0435\u0439, \u043f\u043e \u043a\u0430\u0436\u0434\u043e\u0439 \u0432\u0430\u043b\u044e\u0442\u0435 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e",
                        "content": {
                            "application/json": {
