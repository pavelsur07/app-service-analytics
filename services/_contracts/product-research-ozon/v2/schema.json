{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conwix.com/contracts/product-research-ozon/v2/schema.json",
  "title": "Product research Ozon progress v2",
  "$defs": {
    "month": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "month",
        "date_from",
        "date_to",
        "days",
        "partial"
      ],
      "properties": {
        "month": {
          "type": "string",
          "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$"
        },
        "date_from": {
          "type": "string",
          "format": "date",
          "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-01$"
        },
        "date_to": {
          "type": "string",
          "format": "date",
          "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "partial": {
          "type": "boolean"
        }
      }
    },
    "run_progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "company_id",
        "run_id",
        "status",
        "revision",
        "months"
      ],
      "properties": {
        "schema_version": {
          "const": "2"
        },
        "company_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "ready",
            "error"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "months": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "period",
              "status",
              "snapshot_id",
              "row_count",
              "error_code",
              "origin",
              "collected_at",
              "used_at"
            ],
            "properties": {
              "period": {
                "$ref": "#/$defs/month"
              },
              "status": {
                "enum": [
                  "queued",
                  "running",
                  "ready",
                  "error"
                ]
              },
              "snapshot_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "row_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "error_code": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  null,
                  "contract_violation",
                  "credentials_rejected",
                  "retry_exhausted",
                  "incomplete_snapshot",
                  "deadline_exceeded"
                ]
              },
              "origin": {
                "enum": [
                  null,
                  "api",
                  "cache"
                ]
              },
              "collected_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "used_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "ready"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "snapshot_id": {
                      "type": "string"
                    },
                    "row_count": {
                      "type": "integer"
                    },
                    "error_code": {
                      "type": "null"
                    },
                    "origin": {
                      "enum": [
                        "api",
                        "cache"
                      ]
                    },
                    "collected_at": {
                      "type": "string"
                    },
                    "used_at": {
                      "type": "string"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "origin": {
                      "type": "null"
                    },
                    "collected_at": {
                      "type": "null"
                    },
                    "used_at": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          },
          "maxItems": 24,
          "minItems": 1
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "error"
      ],
      "properties": {
        "schema_version": {
          "const": "2"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code"
          ],
          "properties": {
            "code": {
              "enum": [
                "unauthorized",
                "contract_violation",
                "payload_too_large",
                "not_ready",
                "not_available",
                "not_found",
                "conflict",
                "internal_error",
                "request_timeout",
                "method_not_allowed"
              ]
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/run_progress"
    },
    {
      "$ref": "#/$defs/error"
    }
  ]
}
