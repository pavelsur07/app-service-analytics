{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://conwix.com/contracts/service-coverage/v1/schema.json",
    "title": "Service Coverage",
    "description": "Ответ стандартного endpoint'а сервиса GET /internal/coverage: сводка покрытия данных «ресурс × период → число кабинетов по статусам». Без идентификаторов кабинетов и компаний, без сумм.",
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "service", "generated_at", "from", "to", "cabinets_total", "rows"],
    "properties": {
        "schema_version": {"const": "1"},
        "service": {"type": "string", "minLength": 1, "description": "Имя сервиса из реестра, например ozon-fetcher"},
        "generated_at": {"type": "string", "format": "date-time"},
        "from": {"type": "string", "format": "date", "description": "Первый день окна (включительно), часовой пояс бизнес-периодов сервиса"},
        "to": {"type": "string", "format": "date", "description": "Последний день окна (включительно)"},
        "cabinets_total": {"type": "integer", "minimum": 0, "description": "Активные кабинеты снимка с ключом Seller API — запасное «ожидается» для ресурсов без строк; у рекламы ожидаемое число — cabinets_expected её строк"},
        "rows": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["resource_type", "period_key", "cabinets_expected", "by_status", "last_success_at"],
                "properties": {
                    "resource_type": {"type": "string", "minLength": 1},
                    "period_key": {
                        "type": "string",
                        "pattern": "^(\\d{4}-\\d{2}-\\d{2}|\\d{4}-\\d{2}|ref)$",
                        "description": "YYYY-MM-DD — дневной ресурс, YYYY-MM — месячный, ref — справочник"
                    },
                    "cabinets_expected": {"type": "integer", "minimum": 0, "description": "Активные кабинеты, у которых есть этот ресурс"},
                    "by_status": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["done", "running", "pending", "not_ready", "failed_retryable", "failed_permanent"],
                        "properties": {
                            "done": {"type": "integer", "minimum": 0},
                            "running": {"type": "integer", "minimum": 0},
                            "pending": {"type": "integer", "minimum": 0},
                            "not_ready": {"type": "integer", "minimum": 0},
                            "failed_retryable": {"type": "integer", "minimum": 0},
                            "failed_permanent": {"type": "integer", "minimum": 0}
                        }
                    },
                    "last_success_at": {"type": ["string", "null"], "format": "date-time"}
                }
            }
        }
    }
}
