{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"safe": {"()": "product_research_ozon.infrastructure.observability.SafeJsonFormatter"}},
  "handlers": {"stderr": {"class": "logging.StreamHandler", "formatter": "safe", "stream": "ext://sys.stderr"}},
  "root": {"level": "INFO", "handlers": ["stderr"]},
  "loggers": {
    "uvicorn": {"handlers": [], "propagate": true},
    "uvicorn.error": {"handlers": [], "propagate": true},
    "uvicorn.access": {"handlers": [], "propagate": true}
  }
}
