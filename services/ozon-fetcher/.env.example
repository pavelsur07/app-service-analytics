# Шаблон env сервиса. Значения не коммитятся; секреты — только через env
# (см. README «Переменные окружения» и services/AGENTS.md §5).

LISTEN_ADDR=:8080
# PostgreSQL сервисной БД (prod: общий инстанс в docker-сети, sslmode=disable; dev см. README).
# DB_DSN=postgres://svc_ozon_fetcher:<password>@<host>:5432/ozon_fetcher?sslmode=disable

# Ключи Ozon в env не задаются: приходят по подключению из PHP
# (GET /api/internal/marketplace-connections), живут только в памяти.
# Пусто — загрузка выключена.
# SYMFONY_INTERNAL_BASE_URL=
# Токен «сервис → PHP».
# INTERNAL_AUTH_TOKEN=
# Токен «PHP → сервис» для /internal/* сервиса (≥ 32 символов); пусто — закрыт.
# SERVICE_API_TOKEN=
# CONNECTIONS_POLL_INTERVAL=5m
# Снимок выдачи без подтверждения дольше этого — все задачи стоят (ADR-043 п. 4).
# CONNECTIONS_MAX_STALE=30m
# Только эти подключения (marketplace_account_id через запятую); пусто — ни
# одного (ADR-043 п. 5). Добавляются поимённо, с согласия владельца кабинета.
# OZON_FETCHER_CONNECTION_ALLOWLIST=
# MAX_PARALLEL_CONNECTIONS=

# GlitchTip (Sentry-протокол): только ERROR. Пусто — ошибки только в лог.
# SENTRY_DSN=
# SENTRY_RELEASE=
# SENTRY_ENVIRONMENT=prod

# Хранилище raw (этап 7 docs/plan/ozon-fetcher.md, ADR-044): бакет сырья
# Conwix, ключи — пользователя хранилища с правами на префикс
# conwix/svc/ozon-fetcher/ (префикс зашит в код, здесь не задаётся).
# S3_ENDPOINT=https://s3.twcstorage.ru
# S3_REGION=ru-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
