# Контекст сборки docker/php/Dockerfile — корень репозитория: prod-стадии
# нужен api/. Без этого файла в демон уезжают .git, node_modules и vendor —
# минуты на передачу контекста и риск утащить в образ то, чего там быть
# не должно.

.git/
.github/

# Локальные секреты. Гарантия сильнее .gitignore: тот защищает от коммита,
# этот — от попадания в слой образа, который уедет в реестр.
**/.env.local
**/.env.*.local

node_modules/
**/node_modules/

api/vendor/
api/var/
# tests/ в prod-образе — исполнимый код, который там не нужен.
api/tests/

apps/*/dist/
docs/
test-results/
playwright-report/
var/
