# Контекст сборки docker/php/Dockerfile — корень репозитория: prod-стадии
# нужен api/. Без этого файла в демон уезжают .git, node_modules и vendor —
# минуты на передачу контекста и риск утащить в образ то, чего там быть
# не должно.

.git/
.github/

# Локальные секреты. Гарантия сильнее .gitignore: тот защищает от коммита,
# этот — от попадания в слой образа, который уедет в реестр.
**/.env.local
**/.env.*.local

node_modules/
**/node_modules/

api/vendor/
# var/ — и кэш Symfony, и кэши инструментов (phpstan, phpunit, deptrac,
# php-cs-fixer настроены писать сюда). Одна строка закрывает все.
api/var/
# tests/ в prod-образе — исполнимый код, который там не нужен.
api/tests/

# Конфигурация инструментов разработки: в рантайме не читается,
# а самих инструментов в prod-образе нет.
api/phpstan.neon
api/phpstan-baseline.neon
api/phpunit.dist.xml
api/deptrac.php
api/.php-cs-fixer.dist.php

apps/*/dist/
docs/
# var/ — артефакты Playwright (playwright.config.ts, outputDir).
var/
