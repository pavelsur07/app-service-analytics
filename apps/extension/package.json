{
  "name": "extension",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && npm run build:app && npm run build:content",
    "build:app": "vite build",
    "build:content": "CONWIX_CONTENT=announce vite build && CONWIX_CONTENT=overlay vite build",
    "build:dev": "npm run build:app -- --mode development && CONWIX_CONTENT=announce vite build --mode development && CONWIX_CONTENT=overlay vite build --mode development",
    "watch": "npm run build:dev -- --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "knip": "^6.31.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "unrs-resolver@1.12.2": true,
    "fsevents": false
  },
  "engines": {
    "npm": ">=11.16.0"
  }
}
