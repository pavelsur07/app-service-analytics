includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - phpstan-baseline.neon

parameters:
    level: 9
    # PHPDoc — обещание, а не факт: данные приходят из БД и от площадок,
    # и аннотация расходится с рантаймом молча. С доверием к PHPDoc анализатор
    # считает проверку типа избыточной и снимает её — ровно там, где она нужна.
    treatPhpDocTypesAsCertain: false
    paths:
        - src
        - tests
    # bootstrap.php — recipe-managed Symfony boilerplate, not application code.
    excludePaths:
        - tests/bootstrap.php
    tmpDir: var/phpstan
