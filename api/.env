# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

APP_VERSION=0.1.0-dev

# Публичный origin приложения продавца для ссылок из писем.
SELLER_APP_ORIGIN=http://app.conwix.localhost

# Версия соглашения и политики, которые принимает самостоятельный клиент.
# Клиент не передаёт её сам: сервер сохраняет собственную текущую версию.
REGISTRATION_DOCUMENTS_VERSION=2026-09-02

# Мастер-ключ шифрования учётных данных площадок (ADR-007). Здесь только
# имя переменной: реальное значение живёт в api/.env.local, который
# в .gitignore и в репозиторий не попадает.
APP_ENCRYPTION_MASTER_KEY=

# Не секрет — публичный адрес API площадки, не токен доступа.
OZON_API_BASE_URL=https://api-seller.ozon.ru

# Redis — сессии и rate limit входа (ADR-007), и только (CLAUDE.md).
REDIS_URL=redis://redis:6379

# GlitchTip (протокол Sentry). Пусто — SDK ничего не отправляет
# (config/packages/sentry.yaml). Реальное значение — только в
# api/.env.local (в .gitignore) для dev, на сервере в /opt/conwix/.env
# для прода — не в этом файле и не в репозитории.
SENTRY_DSN=

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

# Ящик, которым приложение аутентифицируется у SMTP-провайдера, он же
# отправитель всех писем: провайдер не даст отправить с чужого домена.
MAILER_FROM=

# Куда уходит оповещение о несвежих данных (docs/operations-checklist.md,
# «письмо себе»). Пусто — команда app:ingestion:check-data-freshness падает
# на первом же тике: контроль свежести, о срабатывании которого никто
# не узнает, хуже отсутствующего.
ALERT_EMAIL=

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:secret@postgres:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

# Сколько последних дней перезагружать по расходам каждым тиком
# планировщика (ADR-006 требует настраиваемое окно). День здесь стоит
# одного запроса к площадке, поэтому умолчание узкое: длинный хвост
# корректировок закрывает глубокий рескан, а не тик.
OZON_EXPENSE_WINDOW_DAYS=3
